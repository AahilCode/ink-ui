# INK UI — Environment variables
# Copy to .env.local and fill in your key

# Google Gemini API key for multimodal analysis (server-side only, never exposed to client)
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override model (default is gemini-2.5-flash-lite – free-tier vision model)
# This model supports image input for camera/sketch analysis + JSON mode for PrototypeRenderer
# Examples:
# gemini-2.5-flash-lite
# gemini-2.5-flash
# AI_MODEL=gemini-2.5-flash-lite

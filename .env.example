# INK UI — Environment variables
# Copy to .env.local and fill in your key

# OpenRouter API key for multimodal analysis (server-side only, never exposed to client)
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override model (default is dots-studio/dots-3-note-preview:free – free Dots3 vision model for Aug 22 demo)
# This model supports image input for camera/sketch analysis + JSON mode for PrototypeRenderer
# Examples of other vision-capable models:
# dots-studio/dots-3-note-preview:free
# openrouter/free
# openai/gpt-4o-mini
# google/gemini-2.0-flash-001
# AI_MODEL=dots-studio/dots-3-note-preview:free

# Optional: for OpenRouter ranking
# OPENROUTER_SITE_URL=https://your-site.com
# OPENROUTER_APP_NAME=INK UI

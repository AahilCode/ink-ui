# INK UI — Environment variables
# Copy to .env.local and fill in your key

# OpenAI API key for multimodal analysis (server-side only, never exposed to client)
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Optional: override model (default is gpt-4o-mini which supports vision)
# Use gpt-4o for higher accuracy, gpt-4o-mini for speed/cost
# AI_MODEL=gpt-4o-mini

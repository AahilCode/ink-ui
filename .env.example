# INK UI — Environment variables
# Copy to .env.local and fill in your key

# OpenRouter API key for multimodal analysis (server-side only, never exposed to client)
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override model (default is openrouter/free – free tier router with vision support)
# openrouter/free routes to free vision-capable models, no paid credits required
# Examples of other vision-capable models:
# openai/gpt-4o-mini
# openai/gpt-4o
# google/gemini-2.0-flash-001
# anthropic/claude-3.5-sonnet
# AI_MODEL=openrouter/free

# Optional: for OpenRouter ranking
# OPENROUTER_SITE_URL=https://your-site.com
# OPENROUTER_APP_NAME=INK UI
